# 复制为 .env 后自己填写。.env 只保存在本机，不要发给任何人。
# 没填的云服务会被自动跳过，路由会使用下一个可用的实现。

# 阿里云百炼（北京地域）：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=

# 可灵（可选）
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=

# 其他 OpenAI 兼容大模型（可选，在 config/providers.yaml 里用 api_key_env 引用）
# ARK_API_KEY=

# 运行参数（可选）
# OUTFIT_CONFIG=config/providers.yaml
# OUTFIT_DATA=data
# OUTFIT_LOG_LEVEL=INFO
